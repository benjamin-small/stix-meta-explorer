{
  "name": "stix-meta-explorer",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "agent:setup": "python3 scripts/agent/bootstrap.py",
    "agent:data": "python3 scripts/agent/prepare_data.py",
    "agent:train": ".agent-venv/bin/python scripts/agent/train.py",
    "agent:export": ".agent-venv/bin/python scripts/agent/export_model.py",
    "agent:assets": "python3 scripts/agent/assets.py",
    "agent:evaluate": "python3 scripts/agent/evaluate.py",
    "agent:test:rust": "cargo test --manifest-path crates/stix-agent-core/Cargo.toml --locked --offline",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3": "^7.4.3",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "happy-dom": "^20.8.4",
    "jsdom": "^29.0.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.0",
    "@vitest/coverage-v8": "^4.1.11"
  }
}
